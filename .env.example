# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1 localhost
# Base URL of the web display, used by the links the bot posts.
WEB_BASE_URL=http://127.0.0.1:8000

# PostgreSQL.
# A DATABASE_URL is usually set by the host platform (e.g. on Dokku, `postgres:link` sets it).
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/boardgamebot

# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
# Guild ID for instant slash-command syncing in development; space-separated for several guilds.
TEST_GUILD_ID=

# Discord OAuth2 of the same application, used by the web login.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Defaults to the callback URL of the running site when empty.
DISCORD_REDIRECT_URI=
